{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jinxk/starbook/schema/pack.schema.json",
  "title": "Starbook pack",
  "description": "One Starbook content pack: homework sheets, awards, milestones, word books and stories. See docs/pack-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["starbook", "id", "revision", "title"],
  "properties": {
    "starbook": {
      "description": "Format version. Always 1 for now.",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/packId"
    },
    "revision": {
      "description": "Whole number. A higher revision replaces an installed pack with the same id.",
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "description": "Shown in the parent area.",
      "$ref": "#/$defs/text"
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "description": "SPDX identifier or plain name of the licence. Default packs are CC0-1.0.",
      "type": "string"
    },
    "sheets": {
      "type": "array",
      "items": { "$ref": "#/$defs/sheet" }
    },
    "awards": {
      "type": "array",
      "items": { "$ref": "#/$defs/award" }
    },
    "milestones": {
      "type": "array",
      "items": { "$ref": "#/$defs/milestone" }
    },
    "wordbooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/wordbook" }
    },
    "stories": {
      "type": "array",
      "items": { "$ref": "#/$defs/story" }
    }
  },
  "$defs": {
    "packId": {
      "description": "Lowercase letters, digits, dots and hyphens.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "itemId": {
      "description": "Id of an item, unique within its list in the pack.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "itemRef": {
      "description": "An item in the same pack (item-id) or in another pack (pack-id/item-id).",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9][a-z0-9.-]*)?$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "description": "BCP 47 tag used for read-aloud, such as en-IN or hi-IN.",
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "picture": {
      "description": "A name from the built-in picture library (docs/pictures.md) or an emoji prefixed with emoji:.",
      "type": "string",
      "pattern": "^(emoji:.+|[a-z0-9][a-z0-9-]*)$"
    },
    "say": {
      "description": "What the text-to-speech voice says instead of the written text.",
      "type": "string",
      "minLength": 1
    },
    "weekday": {
      "type": "string",
      "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
    },
    "colour": {
      "type": "string",
      "enum": ["tomato", "sunflower", "leaf", "sky", "plum", "sand"]
    },
    "icon": {
      "type": "string",
      "enum": ["pencil", "book", "story", "numbers", "letters", "shapes", "music", "draw", "talk", "habit"]
    },
    "trophy": {
      "type": "string",
      "enum": ["cup-gold", "cup-silver", "medal", "ribbon", "crown", "rocket", "rainbow", "star-big", "book-gold", "heart"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "text": { "$ref": "#/$defs/text" },
        "say": { "$ref": "#/$defs/say" },
        "cheer": { "description": "What home says when this task's sticker opens, in place of the line for its icon.", "type": "string", "minLength": 1, "maxLength": 40 },
        "language": { "$ref": "#/$defs/language" },
        "icon": { "$ref": "#/$defs/icon" },
        "opens": {
          "description": "Id of a word book or story. Use pack-id/item-id for another pack.",
          "$ref": "#/$defs/itemRef"
        },
        "bonus": {
          "description": "A bonus task gives an award but is not needed for the day to count as done.",
          "type": "boolean"
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekday", "title", "tasks"],
      "properties": {
        "weekday": { "$ref": "#/$defs/weekday" },
        "title": { "$ref": "#/$defs/text" },
        "colour": { "$ref": "#/$defs/colour" },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "days"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "title": { "$ref": "#/$defs/text" },
        "intro": { "type": "string" },
        "language": { "$ref": "#/$defs/language" },
        "days": {
          "description": "Each weekday appears at most once.",
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/day" }
        },
        "everyDay": {
          "description": "Tasks that appear on every school day.",
          "type": "array",
          "items": { "$ref": "#/$defs/task" }
        },
        "restDays": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/weekday" }
        },
        "restMessage": { "type": "string" },
        "weekGoal": { "type": "string" },
        "habits": {
          "description": "Good habits the child ticks each day. Each id appears at most once.",
          "type": "array",
          "items": { "$ref": "#/$defs/habit" }
        }
      }
    },
    "habit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "picture"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "text": { "$ref": "#/$defs/text" },
        "picture": { "$ref": "#/$defs/picture" },
        "sticker": {
          "description": "A sticker shown when the habit is ticked: a name from the sticker set (docs/stickers.md), not a picture from the library. Optional; without it the habit's picture is shown as a sticker. It is not a book sticker.",
          "$ref": "#/$defs/picture"
        },
        "say": { "$ref": "#/$defs/say" }
      }
    },
    "award": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "kind": {
          "type": "string",
          "enum": ["star", "stamp", "sticker"]
        },
        "label": { "$ref": "#/$defs/text" },
        "say": { "$ref": "#/$defs/say" },
        "language": { "$ref": "#/$defs/language" },
        "colour": { "$ref": "#/$defs/colour" },
        "stars": {
          "description": "How many stars the award counts as. Default 1.",
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "stickers": {
          "description": "Sticker pictures. The app gives a surprise pick among the ones the child does not have yet. Only for kind sticker.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/picture" }
        },
        "retired": {
          "description": "Kept so awards already given still show, never offered. Default false.",
          "type": "boolean"
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "trophy", "when"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "title": { "$ref": "#/$defs/text" },
        "trophy": { "$ref": "#/$defs/trophy" },
        "when": {
          "description": "Exactly one counter and the number to reach.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "stars": { "type": "integer", "minimum": 1 },
            "stickers": { "type": "integer", "minimum": 1 },
            "daysDone": { "type": "integer", "minimum": 1 },
            "weeksDone": { "type": "integer", "minimum": 1 },
            "wordbooksDone": { "type": "integer", "minimum": 1 },
            "storiesRead": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word"],
      "anyOf": [
        { "required": ["picture"] },
        { "required": ["big"] }
      ],
      "dependentRequired": { "count": ["picture"] },
      "properties": {
        "word": { "$ref": "#/$defs/text" },
        "picture": { "$ref": "#/$defs/picture" },
        "big": {
          "description": "Large text shown above the word, for numerals and letters.",
          "$ref": "#/$defs/text"
        },
        "count": {
          "description": "For counting books: the card shows this numeral above this many copies of its picture, in rows of at most 5. Needs picture.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "group": {
          "description": "Cards with the same group sit together; shown as a small tag such as -at.",
          "type": "string"
        },
        "say": { "$ref": "#/$defs/say" },
        "language": { "$ref": "#/$defs/language" }
      }
    },
    "wordbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "cards"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "title": { "$ref": "#/$defs/text" },
        "letter": {
          "description": "Shown big on the cover.",
          "type": "string"
        },
        "colour": { "$ref": "#/$defs/colour" },
        "language": { "$ref": "#/$defs/language" },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/card" }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "description": "One sentence. Over 60 characters is shown smaller and should be split.",
          "$ref": "#/$defs/text"
        },
        "picture": { "$ref": "#/$defs/picture" }
      }
    },
    "credit": {
      "description": "Attribution for stories taken from openly licensed books.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license"],
      "properties": {
        "source": { "type": "string" },
        "url": { "type": "string" },
        "license": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "level", "pages"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "title": { "$ref": "#/$defs/text" },
        "level": {
          "description": "1 is pattern sentences with short-vowel words, 3 has longer sentences.",
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "cover": { "$ref": "#/$defs/picture" },
        "language": { "$ref": "#/$defs/language" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/page" }
        },
        "say": {
          "description": "Word to pronunciation map.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/say" }
        },
        "credit": { "$ref": "#/$defs/credit" }
      }
    }
  }
}
