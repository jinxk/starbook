          "picture": "toothbrush"
        },
        {
          "id": "teeth-night",
          "text": "I brushed my teeth at night",
          "picture": "moon"
        },
        {
          "id": "breakfast",
          "text": "I ate my breakfast with my own hands",
          "picture": "bread"
        },
        {
          "id": "lunch",
          "text": "I ate my lunch with my own hands",
          "picture": "rice"
        },
        {
          "id": "dinner",
          "text": "I ate my dinner with my own hands",
          "picture": "roti"
        }
      ]
