            {
              "id": "wed-shapes",
              "text": "Read and write the names of shapes",
              "icon": "shapes",
              "opens": "starbook.topics/shapes"
            },
            {
              "id": "wed-vowel",
              "text": "Learn vowel I",
              "icon": "letters",
              "opens": "starbook.vowels/short-i"
            }
          ]
        },
        {
          "weekday": "thursday",
          "title": "Animal adventure",
          "colour": "sunflower",
          "tasks": [
            {
              "id": "thu-numbers",
              "text": "Write numbers 31 to 40 with spellings",
