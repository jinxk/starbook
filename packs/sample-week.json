{
  "starbook": 1,
  "id": "starbook.sample-week",
  "revision": 2,
  "title": "Superstar homework week (sample)",
  "author": "Starbook",
  "license": "CC0-1.0",
  "sheets": [
    {
      "id": "superstar-week",
      "title": "Superstar homework week",
      "intro": "Finish your homework each day and fill your page with stars!",
      "days": [
        {
          "weekday": "monday",
          "title": "Alphabet adventure",
          "colour": "sky",
          "tasks": [
            {
              "id": "mon-capitals",
              "text": "Write capital letters A to Z",
              "icon": "pencil"
            },
            {
              "id": "mon-numbers",
              "text": "Write numbers 1 to 10 with spellings",
              "icon": "numbers",
              "opens": "starbook.topics/numbers-1-10"
            },
            {
              "id": "mon-fruits",
              "text": "Read fruit names and write any 5 fruits",
              "icon": "book",
              "opens": "starbook.topics/fruits"
            },
            {
              "id": "mon-days",
              "text": "Read and write the days of the week",
              "icon": "book",
              "opens": "starbook.topics/days"
            },
            {
              "id": "mon-vowel",
              "text": "Learn vowel A",
              "icon": "letters",
              "opens": "starbook.vowels/short-a"
            }
          ]
        },
        {
          "weekday": "tuesday",
          "title": "Little explorer",
          "colour": "leaf",
          "tasks": [
            {
              "id": "tue-small",
              "text": "Write small letters a to z",
              "icon": "pencil"
            },
            {
              "id": "tue-numbers",
              "text": "Write numbers 11 to 20 with spellings",
              "icon": "numbers",
              "opens": "starbook.topics/numbers-11-20"
            },
            {
              "id": "tue-vegetables",
              "text": "Read vegetable names and write any 5 vegetables",
              "icon": "book",
              "opens": "starbook.topics/vegetables"
            },
            {
              "id": "tue-months",
              "text": "Read and write the months of the year",
              "icon": "book",
              "opens": "starbook.topics/months"
            },
            {
              "id": "tue-vowel",
              "text": "Learn vowel E",
              "icon": "letters",
              "opens": "starbook.vowels/short-e"
            }
          ]
        },
        {
          "weekday": "wednesday",
          "title": "Smart learner",
          "colour": "plum",
          "tasks": [
            {
              "id": "wed-numbers",
              "text": "Write numbers 21 to 30 with spellings",
              "icon": "numbers",
              "opens": "starbook.topics/numbers-21-30"
            },
            {
              "id": "wed-hindi",
              "text": "Write Hindi letters अ, आ, इ",
              "icon": "letters",
              "opens": "starbook.hindi/swar",
