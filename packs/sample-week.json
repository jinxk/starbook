        {
          "weekday": "friday",
          "title": "Good habits hero",
          "colour": "tomato",
          "tasks": [
            {
              "id": "fri-numbers",
              "text": "Write numbers 41 to 50 with spellings",
              "icon": "numbers",
              "opens": "starbook.topics/numbers-41-50"
            },
            {
              "id": "fri-habits",
              "text": "Read about good habits",
              "icon": "habit",
              "opens": "starbook.topics/good-habits"
            },
            {
              "id": "fri-transport",
              "text": "Read about transport",
              "icon": "book",
              "opens": "starbook.topics/transport"
            },
            {
              "id": "fri-helpers",
              "text": "Read about community helpers",
              "icon": "book",
              "opens": "starbook.topics/helpers"
            },
            {
              "id": "fri-vowels",
              "text": "Revise vowels A, E, I, O, U",
              "icon": "letters",
              "opens": "starbook.vowels/first-sounds"
            }
          ]
        }
      ],
      "everyDay": [
        {
          "id": "story-time",
          "text": "Read a story with Mumma or Papa",
          "icon": "story",
          "opens": "starbook.first-stories/i-see",
          "bonus": true
        },
        {
          "id": "favourite-part",
          "text": "Tell Mumma or Papa your favourite part",
          "icon": "talk",
          "bonus": true
        }
      ],
      "restDays": [
        "saturday",
        "sunday"
      ],
      "restMessage": "No homework today! Play, draw, dance!",
      "weekGoal": "Finish all five days for a big reward!",
